# Overa environment variables
# Copy to .env (never commit .env) and adjust. Names only — no real values here.
# In production (Vercel) set these in Project → Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Database (required)
# PostgreSQL connection string used by Prisma. Any managed Postgres compatible
# with Prisma works (Prisma Postgres, Neon, Supabase, RDS…).
# NEVER put real credentials in this file or in Git — .env is gitignored.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ---------------------------------------------------------------------------
# Public site URL (required in production — used by the PWA QR code)
# The QR code on the homepage and /install page encodes
# ${NEXT_PUBLIC_SITE_URL}/install. On Vercel set it to the real domain,
# e.g. https://overa.vercel.app — otherwise VERCEL_URL is used automatically
# and localhost is assumed in development.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# SMS / OTP provider (optional)
# When unset, OTP works in a VISIBLY-LABELLED demo mode: the code is returned
# by the API and shown on screen. Set a real provider key only after choosing
# and configuring the provider (see docs/DEPLOYMENT.md).
# ---------------------------------------------------------------------------
SMS_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# Runtime (optional)
# ---------------------------------------------------------------------------
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
