# Overa environment variables
# Copy to .env (never commit .env) and adjust. Names only — no real values here.

# ---------------------------------------------------------------------------
# Database (required)
# PostgreSql file location. In Docker the path must be inside the mounted volume.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://......

# ---------------------------------------------------------------------------
# SMS / OTP provider (optional)
# When unset, OTP works in a VISIBLY-LABELLED demo mode: the code is returned
# by the API and shown on screen. Set a real provider key only after choosing
# and configuring the provider (see docs/DEPLOYMENT.md).
# ---------------------------------------------------------------------------
SMS_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# Runtime (optional)
# ---------------------------------------------------------------------------
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
